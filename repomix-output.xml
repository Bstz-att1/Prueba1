import { initRouter } from './router/router.js';
import { isAuthenticated } from './services/authService.js';

/**
 * Entry point para ejecución estática (ej: npx serve Frontend).
 * Mantiene la misma lógica de bootstrap que main.js.
 */

const ensureAppContainer = () => {
  let app = document.getElementById('app');
  if (app) return app;

  app = document.createElement('div');
  app.id = 'app';

  const main = document.querySelector('main');
  if (main) {
    main.appendChild(app);
  } else {
    document.body.appendChild(app);
  }

  return app;
};

const applyInitialGuard = () => {
  if (window.location.hash) return;
  window.location.hash = isAuthenticated() ? '#/home' : '#/login';
};

const bootstrap = () => {
  ensureAppContainer();
  applyInitialGuard();
  initRouter();
};

window.addEventListener('DOMContentLoaded', bootstrap);
